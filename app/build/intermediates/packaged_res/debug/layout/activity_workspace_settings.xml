<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_50"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="40dp">

        <!-- ===== TOP BAR: "> Settings" + Close ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="› Settings"
                android:textColor="@color/gray_800"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btnSettingsClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="Close"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- ===== HEADER ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Account Settings"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="@color/black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Manage your preferences, workspace, and integrations"
            android:textColor="@color/slate_400"
            android:textSize="12sp" />

        <!-- ===== PERSONAL INFO + WORKSPACE CARD ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="16dp"
            android:background="@drawable/bg_light_card"
            android:orientation="vertical">

            <!-- Section Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personal Information"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Edit your personal details and notification settings"
                android:textColor="@color/slate_400"
                android:textSize="11sp" />

            <!-- Avatar + Name + Email row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp">

                    <ImageView
                        android:id="@+id/settingsUserAvatar"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_avatar_circle"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/settingsUserInitial"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:gravity="center"
                        android:background="@drawable/bg_avatar_circle"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:text="U" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:id="@+id/settingsUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Name"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/settingsUserEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="email@example.com"
                        android:textColor="@color/slate_500"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/settingsAuthMethod"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GOOGLE ACCOUNT"
                        android:textColor="@color/slate_400"
                        android:textSize="10sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.1"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Notification Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="NOTIFICATION EMAIL"
                android:textColor="@color/slate_400"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/slate_200"
                    app:boxStrokeWidth="1dp"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusBottomEnd="8dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputNotificationEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter email for notifications"
                        android:textSize="12sp"
                        android:padding="10dp"
                        android:background="@color/slate_50"
                        android:textColor="@color/black" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:text="Save"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:cornerRadius="6dp"
                    app:backgroundTint="@color/slate_800" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/slate_200" />

            <!-- Workspace Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Workspace: "
                        android:textColor="@color/slate_500"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/settingsWorkspaceName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No Workspace"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Role: "
                        android:textColor="@color/slate_500"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/settingsWorkspaceRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Invite Code: "
                        android:textColor="@color/slate_500"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/settingsInviteCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/black"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Invite / Switch / Leave Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnInvite"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="Invite"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:textColor="@color/slate_900"
                        app:cornerRadius="6dp"
                        app:backgroundTint="@color/white"
                        app:strokeColor="@color/slate_800"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSwitchWorkspace"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Switch"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        app:cornerRadius="6dp"
                        app:backgroundTint="@color/slate_800" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLeaveWorkspace"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Leave"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:textColor="@color/danger"
                        app:cornerRadius="6dp"
                        app:backgroundTint="@color/white"
                        app:strokeColor="@color/danger"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <!-- Timezone -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="TIMEZONE"
                    android:textColor="@color/slate_400"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <Spinner
                    android:id="@+id/spinnerTimezone"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_light_card"
                    android:padding="8dp"
                    android:popupBackground="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== CONTENT STRATEGY SECTION ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_light_card"
            android:orientation="vertical">

            <!-- Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_indigo_icon">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="💡"
                        android:textSize="16sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Content Strategy"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/gray_900" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Define your brand's core focus and target audience"
                        android:textColor="@color/gray_500"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveStrategy"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Save"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    app:cornerRadius="6dp"
                    app:backgroundTint="@color/indigo_600" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gray_100" />

            <!-- Content Fields -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:orientation="vertical">

                <!-- Domain -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRIMARY DOMAIN"
                    android:textColor="@color/gray_700"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/slate_200"
                    app:boxStrokeWidth="1dp"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputDomain"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. B2B SaaS, Healthcare, Fintech..."
                        android:textSize="13sp"
                        android:textColor="@color/slate_800"
                        android:padding="12dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="The primary industry or topic your content covers."
                    android:textColor="@color/slate_400"
                    android:textSize="10sp" />

                <!-- Target Audience -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="TARGET AUDIENCE"
                    android:textColor="@color/gray_700"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/slate_200"
                    app:boxStrokeWidth="1dp"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputAudience"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. CTOs, Small Business Owners, Gen Z..."
                        android:textSize="13sp"
                        android:textColor="@color/slate_800"
                        android:padding="12dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Who you are writing for. Helps tailor tone and complexity."
                    android:textColor="@color/slate_400"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== PLATFORM INTEGRATION SECTION ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Platform Integration"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/black" />

        <!-- LinkedIn Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_light_card"
            android:orientation="vertical">

            <!-- LinkedIn Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Icon -->
                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_linkedin_icon">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="in"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@color/linkedin_blue" />
                </FrameLayout>

                <!-- Name + Description -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LinkedIn"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/gray_900" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Professional branding &amp; company page posting"
                        android:textColor="@color/gray_600"
                        android:textSize="10sp"
                        android:layout_marginTop="1dp" />
                </LinearLayout>

                <!-- Status Badge -->
                <TextView
                    android:id="@+id/linkedinStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disconnected"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/slate_500"
                    android:background="@drawable/bg_status_disconnected"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />
            </LinearLayout>

            <!-- LinkedIn Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp"
                android:orientation="horizontal"
                android:gravity="end">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLinkedinConnect"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Connect"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    app:cornerRadius="6dp"
                    app:backgroundTint="@color/linkedin_blue" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLinkedinDisconnect"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:text="Disconnect"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@color/danger"
                    android:visibility="gone"
                    app:cornerRadius="6dp"
                    app:backgroundTint="@color/white"
                    app:strokeColor="@color/danger"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- LinkedIn Expanded Details (Visible when connected) -->
            <LinearLayout
                android:id="@+id/linkedinDetailsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="@drawable/bg_light_card"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/slate_200"
                    android:layout_marginBottom="12dp" />

                <!-- Member Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/bg_avatar_circle"
                        android:background="@color/slate_200"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:id="@+id/linkedinMemberName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Member Name"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:textColor="@color/gray_900" />
                        <TextView
                            android:id="@+id/linkedinMemberHeadline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Headline"
                            android:textColor="@color/gray_600"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LINKEDIN PAGES"
                    android:textColor="@color/slate_400"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/linkedinPagesList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- Organizations will be added here dynamically -->
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- Twitter Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_light_card"
            android:orientation="vertical">

            <!-- Twitter Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Icon -->
                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_twitter_icon">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="𝕏"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@color/black" />
                </FrameLayout>

                <!-- Name + Description -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Twitter / X"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/gray_900" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fast content updates &amp; quick audience interactions"
                        android:textColor="@color/gray_600"
                        android:textSize="10sp"
                        android:layout_marginTop="1dp" />
                </LinearLayout>

                <!-- Status Badge -->
                <TextView
                    android:id="@+id/twitterStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disconnected"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/slate_500"
                    android:background="@drawable/bg_status_disconnected"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />
            </LinearLayout>

            <!-- Twitter Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp"
                android:orientation="horizontal"
                android:gravity="end">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTwitterConnect"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Connect"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    app:cornerRadius="6dp"
                    app:backgroundTint="@color/slate_900" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTwitterDisconnect"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:text="Disconnect"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@color/danger"
                    android:visibility="gone"
                    app:cornerRadius="6dp"
                    app:backgroundTint="@color/white"
                    app:strokeColor="@color/danger"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== LOGOUT ===== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="24dp"
            android:text="Log Out"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="@color/danger"
            app:cornerRadius="10dp"
            app:backgroundTint="@color/white"
            app:strokeColor="@color/gray_200"
            app:strokeWidth="1dp" />

    </LinearLayout>
</ScrollView>
