<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Format chips grid — dynamically populated -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/formatChipGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp" />

    <!-- Optional theme input -->
    <EditText
        android:id="@+id/themeInput"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="Theme / Tone (optional)"
        android:textSize="13sp"
        android:textColor="@color/slate_800"
        android:textColorHint="@color/slate_400"
        android:background="@drawable/bg_light_card"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:inputType="text"
        android:layout_marginBottom="10dp" />

    <!-- Create button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCreate"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="Create drafts"
        android:textSize="12sp"
        android:textAllCaps="false"
        android:backgroundTint="@color/slate_900"
        android:textColor="@color/white"
        android:enabled="false"
        style="@style/Widget.Material3.Button" />

</LinearLayout>
