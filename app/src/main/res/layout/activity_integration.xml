<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Platform Integration"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connect accounts to publish and track performance"
            android:textColor="@color/gray_700"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:id="@+id/linkedinCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="16dp"
            android:background="@drawable/bg_light_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LinkedIn"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/linkedinStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Not connected"
                android:textColor="@color/gray_700"
                android:layout_marginTop="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLinkedinConnect"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Connect"
                    android:textAllCaps="false"
                    app:cornerRadius="10dp"
                    app:backgroundTint="@color/navy_950" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLinkedinDisconnect"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Disconnect"
                    android:textAllCaps="false"
                    app:cornerRadius="10dp"
                    app:backgroundTint="@color/white"
                    app:strokeColor="@color/gray_300"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/twitterCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="16dp"
            android:background="@drawable/bg_light_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Twitter/X"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/twitterStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Not connected"
                android:textColor="@color/gray_700"
                android:layout_marginTop="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTwitterConnect"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Connect"
                    android:textAllCaps="false"
                    app:cornerRadius="10dp"
                    app:backgroundTint="@color/navy_950" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTwitterDisconnect"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Disconnect"
                    android:textAllCaps="false"
                    app:cornerRadius="10dp"
                    app:backgroundTint="@color/white"
                    app:strokeColor="@color/gray_300"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIntegrationContinue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Continue to Chat"
            android:textAllCaps="false"
            android:layout_marginTop="24dp"
            app:cornerRadius="10dp"
            app:backgroundTint="@color/navy_950" />

    </LinearLayout>
</ScrollView>
